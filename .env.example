# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Cryptographic secret for signing HTTP-only session cookies.
SESSION_SECRET="change-this-to-a-long-random-secret"

# FLASK_ENV / MYSQL settings (for the pcm/ Python Flask + MySQL 8.0 stack)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="pcm_user"
MYSQL_PASSWORD="change_this_password"
MYSQL_DATABASE="pcm_db"
NOMINATIM_USER_AGENT="PCM-CivicTechPlatform/1.0"
